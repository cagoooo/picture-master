rules_version = '2';

// picture-master quota tracking — only Cloud Functions (admin SDK) may read/write.
// Browser-side access is fully denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /quota/{docId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
